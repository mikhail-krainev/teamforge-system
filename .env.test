# Client settings for the test stack (docker-compose.test.yml). Public test values, not secrets.
# Loaded by scripts/run-tests.mjs. Without these variables the integration tests are skipped explicitly.
NODE_ENV=test
# Application connection (role tf_app: no DDL, no superuser) goes through PgBouncer (prepare=false);
# fixtures and migrations use the direct URL as the owner role tf_migrator.
DATABASE_URL=postgres://tf_app:tf_test_app@127.0.0.1:6433/teamforge
DATABASE_DIRECT_URL=postgres://tf_migrator:tf_test_migrator@127.0.0.1:5433/teamforge
REDIS_URL=redis://api:tf_test_redis_api@127.0.0.1:6380
REDIS_RESUME_URL=redis://resume_producer:tf_test_resume_producer@127.0.0.1:6381
# Real S3 (SeaweedFS) for the storage smoke test; the API tests otherwise use an in-process S3 double.
S3_TEST_ENDPOINT=http://127.0.0.1:9100
S3_TEST_ACCESS_KEY=tftestaccesskey
S3_TEST_SECRET_KEY=tftestsecretkey0123456789
