# Local production-like run without a domain (docs/local-run.md). Used as the second --env-file after .env
# (the later file wins): host ports move off 4000/9000/1025/8025, which other local stacks often hold.
# The site stays on http://localhost:3000.
WEB_PORT=3000
WEB_URL=http://localhost:3000
# The browser reaches the api only through the web origin (web proxies /api): OAuth callbacks and
# relative redirects must resolve there, not on the api port.
BETTER_AUTH_URL=http://localhost:3000
API_PORT=34000
POSTGRES_HOST_PORT=35432
PGBOUNCER_HOST_PORT=36432
REDIS_HOST_PORT=36379
S3_HOST_PORT=39000
FILES_PUBLIC_ORIGIN=http://localhost:39000
SMTP_HOST_PORT=31025
MAILPIT_UI_PORT=38025
# A documentation address: the link-checker refuses to start in production mode without SELF_PUBLIC_IPS.
SELF_PUBLIC_IPS=192.0.2.10
