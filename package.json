{
  "name": "teamforge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint && eslint scripts",
    "test": "pnpm -r run --if-present test && node --test scripts/*.test.mjs",
    "build": "pnpm -r run --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contract:generate": "pnpm --filter shared run generate",
    "contract:check": "node scripts/check-contract.mjs",
    "contract:test": "node --test scripts/*.test.mjs",
    "contract:breaking": "node scripts/contract-breaking.mjs",
    "env:init": "node scripts/env-init.mjs",
    "gen:module": "node scripts/gen-module.mjs",
    "depcruise": "pnpm --filter api run depcruise",
    "db:check": "pnpm --filter api run db:check",
    "trace:fr": "node scripts/trace-fr.mjs",
    "test:env:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:env:down": "docker compose -f docker-compose.test.yml down -v",
    "test:integration": "node scripts/with-env.mjs .env.test -- pnpm --filter api run test",
    "test:coverage": "node scripts/with-env.mjs .env.test -- pnpm --filter api run test:coverage",
    "test:concurrency": "node scripts/with-env.mjs .env.test --repeat 5 -- pnpm --filter api exec vitest run test/concurrency",
    "test:e2e": "pnpm --filter web run test:e2e",
    "deps:check": "node scripts/check-deps.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "yaml": "2.9.1"
  }
}
