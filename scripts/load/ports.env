# Isolated load-test stack: compose project `tf-release`, host ports and subnet that do not collide with
# the dev (`teamforge`), `tf-test` and `e2e` stacks. Used as the second --env-file (the later file wins).
API_PORT=24000
WEB_PORT=23000
WEB_URL=http://localhost:23000
BETTER_AUTH_URL=http://localhost:23000
POSTGRES_HOST_PORT=25432
PGBOUNCER_HOST_PORT=26432
REDIS_HOST_PORT=26379
S3_HOST_PORT=29000
FILES_PUBLIC_ORIGIN=http://localhost:29000
SMTP_HOST_PORT=21025
MAILPIT_UI_PORT=28025
TF_NET_SUBNET=172.29.240.0/24
TF_WEB_IP=172.29.240.10
# A documentation address: the link-checker refuses to start in production mode without SELF_PUBLIC_IPS.
SELF_PUBLIC_IPS=192.0.2.10
