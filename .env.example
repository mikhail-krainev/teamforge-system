# Copy to .env and fill in (`pnpm run env:init` generates missing secrets). Never commit .env.
# Variable list: docs/architecture.md 13.11. Secrets are intentionally left empty.

# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
LOG_LEVEL=info
# Where the web container reaches the API. Next.js rewrites are resolved at BUILD time, so this is
# a build argument of the web image (compose passes http://api:4000); on the host it is localhost.
API_INTERNAL_URL=http://localhost:4000

# PostgreSQL has three roles (docker/postgres/10-roles.sh):
#   postgres     superuser (POSTGRES_PASSWORD): created by the image, used for administration only;
#   tf_migrator  owns the database and its schemas, runs migrations (TF_MIGRATOR_PASSWORD);
#   tf_app       what api and worker use: DML only, no DDL, not a superuser (TF_APP_PASSWORD).
# DATABASE_URL (tf_app) goes through PgBouncer (prepare=false); DATABASE_DIRECT_URL (tf_migrator) is for
# migrate only. env:init puts the matching password into the empty password of the URLs below.
POSTGRES_PASSWORD=
TF_MIGRATOR_PASSWORD=
TF_APP_PASSWORD=
DATABASE_URL=postgres://tf_app:@localhost:6432/teamforge
DATABASE_DIRECT_URL=postgres://tf_migrator:@localhost:5432/teamforge
DATABASE_POOL_MAX=20

# Redis: separate ACL user per process (user and password required in the URL).
# The passwords below feed docker/redis/users.acl.tpl; env:init copies them into the URLs.
REDIS_API_PASSWORD=
REDIS_WORKER_PASSWORD=
REDIS_LINKCHECK_PASSWORD=
REDIS_RESUME_PRODUCER_PASSWORD=
REDIS_RESUME_PASSWORD=
REDIS_URL=redis://api:@localhost:6379
REDIS_LINKCHECK_URL=redis://linkcheck:@localhost:6379
REDIS_RESUME_URL=redis://resume_producer:@localhost:6380
# BullMQ key prefix (the Redis ACL grants ~bull:*); tests use a unique prefix per run
QUEUE_PREFIX=bull
# Check the ACL user name and password in REDIS_URL at startup (architecture 13.16)
REDIS_ACL_STRICT=true

# Network: SSRF deny-list addition (public IPs of the host) and trusted proxies for trustProxy.
# TRUSTED_PROXY_CIDRS is a comma-separated list of proxy addresses whose X-Forwarded-For is believed.
# Empty (default) trusts nobody. Docker Compose then trusts only the web container (/32); list the
# real proxies (Caddy, web) explicitly when deploying.
SELF_PUBLIC_IPS=
TRUSTED_PROXY_CIDRS=

# S3-compatible storage (SeaweedFS locally, ADR-0019; any S3 API in production)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_RESUMES=resumes
S3_BUCKET_ARTIFACTS=artifacts
FILES_PUBLIC_ORIGIN=http://localhost:9000

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
APP_ORIGIN=http://localhost:3000

# GitHub sign-in (optional; default to GITHUB_APP_CLIENT_ID / GITHUB_APP_CLIENT_SECRET)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Encryption and hashing
DATA_ENCRYPTION_KEY=
IP_HASH_SALT=

# Backups: public age key only (the private key is never stored on the server)
BACKUP_AGE_RECIPIENT=

# Mail (Mailpit locally)
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Teamforge <no-reply@localhost>

# Optional: GitHub numeric ids of administrators seeded by migrate (comma-separated)
ADMIN_GITHUB_IDS=
