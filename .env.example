# Copy to .env and fill in. Never commit .env.

# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# PostgreSQL (via PgBouncer)
DATABASE_URL=postgres://teamforge:teamforge@localhost:6432/teamforge
DATABASE_DIRECT_URL=postgres://teamforge:teamforge@localhost:5432/teamforge

# Redis (sessions, cache, BullMQ, pub/sub)
REDIS_URL=redis://localhost:6379

# Auth
SESSION_SECRET=change-me

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=teamforge-artifacts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
UPLOAD_MAX_BYTES=10485760

# GitHub integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
