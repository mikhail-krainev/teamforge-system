# Copy to .env and fill in (`pnpm run env:init` generates missing secrets). Never commit .env.
# Variable list: docs/architecture.md 13.11. Secrets are intentionally left empty.

# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# PostgreSQL: DATABASE_URL goes through PgBouncer (prepare=false); DATABASE_DIRECT_URL is for migrate only
DATABASE_URL=postgres://teamforge:@localhost:6432/teamforge
DATABASE_DIRECT_URL=postgres://teamforge:@localhost:5432/teamforge

# Redis: separate ACL user per process (user and password required in the URL)
REDIS_URL=redis://api:@localhost:6379
REDIS_LINKCHECK_URL=redis://linkcheck:@localhost:6379
REDIS_RESUME_URL=redis://resume_producer:@localhost:6380

# Network: SSRF deny-list addition (public IPs of the host) and trusted proxies for trustProxy
SELF_PUBLIC_IPS=
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_RESUMES=resumes
S3_BUCKET_ARTIFACTS=artifacts
FILES_PUBLIC_ORIGIN=http://localhost:9000

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
APP_ORIGIN=http://localhost:3000

# GitHub sign-in (optional; default to GITHUB_APP_CLIENT_ID / GITHUB_APP_CLIENT_SECRET)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Encryption and hashing
DATA_ENCRYPTION_KEY=
IP_HASH_SALT=

# Backups: public age key only (the private key is never stored on the server)
BACKUP_AGE_RECIPIENT=

# Mail (Mailpit locally)
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Teamforge <no-reply@localhost>

# Optional: GitHub numeric ids of administrators seeded by migrate (comma-separated)
ADMIN_GITHUB_IDS=
