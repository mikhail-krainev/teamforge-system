{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx src/platform/db/migrate.ts",
    "migrate:prod": "node dist/platform/db/migrate.js",
    "playbooks:load": "tsx src/cli/playbooks-load.ts",
    "playbooks:load:prod": "node dist/cli/playbooks-load.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/check-migrations.mjs",
    "depcruise": "depcruise src test --config ../../.dependency-cruiser.cjs",
    "gen:module": "node ../../scripts/gen-module.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@fastify/websocket": "11.3.4",
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "2.0.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-auth": "1.7.7",
    "bullmq": "6.3.13",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "mammoth": "1.13.0",
    "nestjs-cls": "7.0.1",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.1.0",
    "pdfjs-dist": "6.4.299",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "shared": "workspace:*",
    "unpdf": "1.8.1",
    "uuidv7": "1.2.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/nodemailer": "8.0.2",
    "@vitest/coverage-v8": "5.0.4",
    "dependency-cruiser": "18.6.0",
    "drizzle-kit": "0.31.11",
    "eslint-plugin-boundaries": "7.2.0",
    "tsx": "4.23.15",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
